    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {"@fontsource/ibm-plex-sans": "^5.2.8", "express": "^5.1.0", "react": "^19.1.0", "react-dom": "^19.1.0", "vosk-browser": "^0.0.8", "zod": "^4.1.0"},
  "devDependencies": {"@types/express": "^5.0.3", "@types/node": "^24.0.0", "@types/react": "^19.1.0", "@types/react-dom": "^19.1.0", "@vitejs/plugin-react": "^5.0.0", "tsx": "^4.20.0", "typescript": "^5.9.0", "vite": "^7.1.0", "@playwright/test": "^1.56.0"}
}
