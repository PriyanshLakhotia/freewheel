{
  "name": "freewheel", "version": "0.1.0", "private": true, "type": "module",
  "description": "A hands-free voice cockpit for Amp and Codex",
  "engines": {"node": ">=22.0.0"},
  "scripts": {
    "dev": "tsx server/index.ts", "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
