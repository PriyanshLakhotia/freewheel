{
  "name": "freewheel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A hands-free voice cockpit for Amp and Codex",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke:amp": "tsx scripts/smoke-agents.ts amp",
    "smoke:codex": "tsx scripts/smoke-agents.ts codex",
    "smoke:concurrency": "tsx scripts/smoke-concurrency.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openai/codex": "0.163.0",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vosk-browser": "^0.0.8",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "overrides": {
    "vosk-browser": {
      "uuid": "^11.1.1"
    }
  }
}
